# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/ai_quiz_app
TEST_DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/ai_quiz_app_test

# Redis (used for rate limiting)
REDIS_URL=redis://localhost:6379

# LLM providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Worker / pool tuning
WORKER_ENABLED=True
POOL_THRESHOLD=5
POOL_TARGET=10
POOL_INTERVAL_SECONDS=60

# Rate limiting
RATE_LIMIT_PER_MINUTE=30


POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=ai_quiz_app